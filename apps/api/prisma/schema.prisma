generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCode {
  ENTRY
  LITE
  PRO
  SCALE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum VoiceMode {
  LIBRARY
  CUSTOM_PROMPT
}

enum CharacterStatus {
  DRAFT
  READY
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  tokensBalance Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  tokenLedger   TokenLedgerEntry[]
  characters    Character[]
}

model Subscription {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  plan           PlanCode
  status         SubscriptionStatus @default(PENDING)
  paymentId      String?            @unique
  renewsAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId])
}

model TokenLedgerEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Character {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  name             String
  status           CharacterStatus @default(DRAFT)

  bodyType         String?
  hairColor        String?
  hairLength       String?
  eyeColor         String?
  noseType         String?
  lipsType         String?
  facialHair       String?
  clothingStyle    String?
  previewImageUrl  String?

  voiceMode        VoiceMode?
  voiceId          String?
  voicePrompt      String?

  nicheCategory    String?
  nicheSubcategory String?
  nicheCustomText  String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
}
