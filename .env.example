# Postgres (apps/api)
DATABASE_URL="postgresql://studyon:studyon@localhost:5432/studyon?schema=public"

# JWT
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Kaspi Pay (заполнить, когда будет мерчант-доступ; до этого используется MockPaymentProvider)
KASPI_MERCHANT_ID=""
KASPI_API_KEY=""
PAYMENT_PROVIDER="mock" # mock | kaspi

# apps/api
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
API_PUBLIC_URL="http://localhost:4000" # адрес, по которому фронт/HeyGen смогут скачать загруженные файлы

# Хранилище файлов (цифровой образ). local — только для разработки, файлы не переживут
# передеплой на Railway. Для продакшена — STORAGE_PROVIDER=r2 + ключи Cloudflare R2.
STORAGE_PROVIDER="local" # local | r2
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# Flux — редактирование фото по референсу (fal.ai). До заполнения FAL_KEY используется MockImageEditProvider.
IMAGE_EDIT_PROVIDER="mock" # mock | flux
FAL_KEY=""
FAL_MODEL_ID="fal-ai/flux-pro/kontext"

# HeyGen — говорящее видео по фото. До заполнения HEYGEN_API_KEY используется MockVideoAvatarProvider.
VIDEO_AVATAR_PROVIDER="mock" # mock | heygen
HEYGEN_API_KEY=""
HEYGEN_VOICE_ID="" # id голоса из личного кабинета HeyGen, обязателен для генерации видео

# OpenAI — генерация текстовых постов. До заполнения OPENAI_API_KEY используется MockTextProvider.
LLM_PROVIDER="mock" # mock | openai
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_INTERNAL_URL="http://localhost:4000"
